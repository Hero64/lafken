{
  // Type-checks the config and script files that live outside any package, so
  // an option vitest no longer supports fails `pnpm check-types` instead of
  // being silently ignored at runtime.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["../vitest.coverage.mts"]
}
