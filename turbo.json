{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "concurrency": "1000",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["lib/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.mts", "vitest.setup.mts"]
    },
    "test:coverage": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.mts", "vitest.setup.mts"],
      "outputs": ["coverage/**"]
    }
  }
}
